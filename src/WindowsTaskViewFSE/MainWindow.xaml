<Window x:Class="WindowsTaskViewFSE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsTaskViewFSE.Views"
        xmlns:viewModels="clr-namespace:WindowsTaskViewFSE.ViewModels"
        xmlns:helpers="clr-namespace:WindowsTaskViewFSE.Helpers"
        mc:Ignorable="d"
        Title="Windows Task View - Xbox FSE"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        Focusable="True"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Controller Button Badge Style -->
        <Style x:Key="ControllerBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Keyboard Key Badge Style -->
        <Style x:Key="KeyboardBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Pure black background, no ambient glow -->
    <Grid Background="#000000">

        <Grid.RowDefinitions>
            <!-- Header (Section title, search, controller/clock status) -->
            <RowDefinition Height="76"/>
            <!-- Main Content (Horizontally scrolling tile carousel) -->
            <RowDefinition Height="*"/>
            <!-- Footer (Xbox HUD Controls) -->
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Grid Grid.Row="0" Margin="40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Section title (current position indicator) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Jump back in"
                           Foreground="#FFFFFF"
                           FontSize="22"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#8A8A8A"
                           FontSize="12.5"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Center: Search Filter Box -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    Width="340"
                    Height="36"
                    Background="#141414"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="M 10,10 L 15,15 M 11,6 A 5,5 0 1,1 1,6 A 5,5 0 1,1 11,6"
                          Stroke="#8A8A8A"
                          StrokeThickness="1.8"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFFFF"
                             CaretBrush="#00D4FF"
                             FontSize="13.5"
                             VerticalAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                        <VisualBrush.Visual>
                                            <Label Content="Filter open apps..." Foreground="#5A5A5A" FontSize="13.5" Padding="0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Right: Controller Status & Clock -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#141414"
                        CornerRadius="14"
                        Padding="10,4"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#3A3A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsControllerConnected}" Value="True">
                                            <Setter Property="Fill" Value="#00D4FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="CONTROLLER"
                                   Foreground="#8A8A8A"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding HeaderTime}"
                           Foreground="#FFFFFF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
            </StackPanel>
        </Grid>

        <!-- MAIN TILES CONTAINER: horizontal scrolling multi-row carousel -->
        <Grid Grid.Row="1">
            <!-- Empty State when no apps found -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalWindowsCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="64" Height="64" CornerRadius="32" Background="#141414" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="M 12,12 L 36,36 M 36,12 L 12,36"
                          Stroke="#4A4A4A"
                          StrokeThickness="3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No Open Applications Found"
                           Foreground="#FFFFFF"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Open an application on your desktop or press [Y] / [F5] to refresh."
                           Foreground="#6A6A6A"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 3-WINDOW CAROUSEL: exactly 3 fixed slots (previous / active / next), never scrolled.
                 The center tile is the focused/active window (cyan border, full size); the left
                 and right tiles are the previous/next windows in the circular list (smaller,
                 dimmed). Navigating swaps which WindowTileViewModel is bound to each slot. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <views:WindowTile DataContext="{Binding LeftTile}"
                                   Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
                <views:WindowTile DataContext="{Binding CenterTile}"
                                   Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
                <views:WindowTile DataContext="{Binding RightTile}"
                                   Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- FOOTER HUD BAR (Xbox Controller & Keyboard Navigation Guides) -->
        <Border Grid.Row="2"
                Background="#0A0A0A"
                BorderBrush="#1E1E1E"
                BorderThickness="0,1,0,0"
                Padding="32,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Hints -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- (A) / [Enter] Select -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource ControllerBadgeStyle}" Background="#00D4FF">
                            <TextBlock Text="A" Foreground="Black" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource KeyboardBadgeStyle}">
                            <TextBlock Text="Enter" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Select" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- (B) / [Esc] Close Task View -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource ControllerBadgeStyle}" Background="#D83B01">
                            <TextBlock Text="B" Foreground="White" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource KeyboardBadgeStyle}">
                            <TextBlock Text="Esc" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Close" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- (X) / [Del] Close App -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource ControllerBadgeStyle}" Background="#0078D7">
                            <TextBlock Text="X" Foreground="White" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource KeyboardBadgeStyle}">
                            <TextBlock Text="Del" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Close App" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- (Y) / [F5] Refresh -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource ControllerBadgeStyle}" Background="#FFB900">
                            <TextBlock Text="Y" Foreground="#111111" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource KeyboardBadgeStyle}">
                            <TextBlock Text="F5" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Refresh" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- (D-Pad / Arrows / LB-RB) Navigate -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource ControllerBadgeStyle}" Background="#2A2A2A">
                            <TextBlock Text="+" Foreground="White" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <Border Style="{StaticResource KeyboardBadgeStyle}">
                            <TextBlock Text="Arrows / LB-RB" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Navigate" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Xbox Guide tip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Xbox Full Screen Experience"
                               Foreground="#4A4A4A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
