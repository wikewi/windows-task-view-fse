<UserControl x:Class="WindowsTaskViewFSE.Views.WindowTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:WindowsTaskViewFSE.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:WindowTileViewModel}"
             Focusable="False"
             Cursor="Hand"
             Margin="14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Width="380"
          Height="250"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Main Card Border with Xbox Style Shadow and Highlight -->
        <Border x:Name="CardBorder"
                Background="#1E1E1E"
                BorderBrush="#383838"
                BorderThickness="2"
                CornerRadius="12"
                ClipToBounds="True">

            <Border.Effect>
                <DropShadowEffect x:Name="TileShadow"
                                  Color="#107C10"
                                  BlurRadius="0"
                                  ShadowDepth="0"
                                  Opacity="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header with app icon and title -->
                    <RowDefinition Height="46"/>
                    <!-- Thumbnail preview -->
                    <RowDefinition Height="*"/>
                    <!-- Footer / Badge -->
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0"
                        Background="#252525"
                        Padding="12,0,8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Image Grid.Column="0"
                               Source="{Binding Icon}"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Title and Process Name -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="#FFFFFF"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding ProcessName}"
                                       Foreground="#888888"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Close Button (X) -->
                        <Button Grid.Column="2"
                                Command="{Binding CloseCommand}"
                                ToolTip="Close Application (X / Del)"
                                Width="26"
                                Height="26"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="Transparent"
                                                        CornerRadius="13"
                                                        Padding="4">
                                                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                                                          Stroke="#AAAAAA"
                                                          StrokeThickness="1.6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Window Thumbnail Area -->
                <Border Grid.Row="1"
                        Background="#141414"
                        Margin="0">
                    <Grid>
                        <!-- Thumbnail Image -->
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Focus Overlay Highlight -->
                        <Border x:Name="FocusOverlay"
                                Background="#107C10"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <!-- Minimized Badge if minimized -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="#B3000000"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MINIMIZED"
                                       Foreground="#CCCCCC"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer Status Bar -->
                <Border Grid.Row="2"
                        Background="#1D1D1D"
                        Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding Index, StringFormat='#{0}'}"
                                   Foreground="#666666"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <StackPanel x:Name="FocusHint"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Opacity="0">
                            <Border Background="#107C10"
                                    CornerRadius="9"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,6,0">
                                <TextBlock Text="A"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Press A / Enter to switch"
                                       Foreground="#107C10"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Triggers>
        <!-- Triggers will also be handled in code-behind for smooth property changed bindings -->
    </UserControl.Triggers>
</UserControl>
