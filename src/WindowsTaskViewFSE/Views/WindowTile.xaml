<UserControl x:Class="WindowsTaskViewFSE.Views.WindowTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:WindowsTaskViewFSE.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:WindowTileViewModel}"
             Focusable="False"
             Cursor="Hand"
             Margin="12">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Large horizontal card: thumbnail fills the entire tile, name overlaid at the bottom.
         No black bars or extra padding around the tile content. -->
    <Grid x:Name="RootGrid"
          Width="360"
          Height="336"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="CardBorder"
                Background="#000000"
                BorderBrush="#3A3A3A"
                BorderThickness="2"
                CornerRadius="8"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Live preview area: DWM composites the actual live window content here. -->
                    <RowDefinition Height="*"/>
                    <!-- Title strip: kept out of the preview row so the live DWM overlay (which
                         is drawn by the compositor above everything at that screen location)
                         never covers the app name/icon, matching the Xbox FSE layout where the
                         title sits below the preview instead of on top of it. -->
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Static fallback thumbnail: fills the preview row only. While this tile is one
                     of the 3 visible carousel slots, a live DWM window preview (registered in
                     code-behind) is composited by the OS directly on top of this same area, so
                     this bitmap is only ever visible as a brief fallback before the live preview
                     attaches (or if live preview registration fails). -->
                <Image x:Name="PreviewSurface"
                       Grid.Row="0"
                       Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Title strip background -->
                <Border Grid.Row="1" Background="#D6000000"/>

                <!-- App name / process name -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,14,0">
                    <Image Source="{Binding Icon}"
                           Width="22"
                           Height="22"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="#FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"
                                   ToolTip="{Binding Title}"/>
                        <TextBlock Text="{Binding ProcessName}"
                                   Foreground="#B0B0B0"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Minimized badge -->
                <Border Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Background="#B3000000"
                        CornerRadius="4"
                        Padding="6,2"
                        Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MINIMIZED"
                               Foreground="#CCCCCC"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>

                <!-- Close (X) button, visible on hover/focus via code-behind opacity -->
                <Button x:Name="CloseButton"
                        Grid.Row="0"
                        Command="{Binding CloseCommand}"
                        ToolTip="Close Application (X / Del)"
                        Width="30"
                        Height="30"
                        Margin="8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Opacity="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder"
                                                Background="#801A1A1A"
                                                CornerRadius="15"
                                                Padding="4">
                                            <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1.8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
